# Public API URL used by the client at build time.
# In Railway, set this to the deployed service domain, e.g.:
# EXPO_PUBLIC_API_URL=https://${{ gregarious-bravery.RAILWAY_PUBLIC_DOMAIN }}
EXPO_PUBLIC_API_URL=http://localhost:3000

# Secret used to sign/verify JWTs. Generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Set this in Railway's environment variables — do not commit the real value.
JWT_SECRET=
